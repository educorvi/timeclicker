    "npm-run-all": "^4.1.5",
    "prettier": "^3.9.6",
    "sass": "^1.102.0",
    "semantic-release": "^25.0.9",
    "semantic-release-monorepo": "^8.0.2",
    "semantic-release-yarn": "^3.0.2",
    "typescript": "~6.0.3",
    "unplugin-icons": "^23.0.1",
    "unplugin-vue-components": "^32.1.0",

    "axios": "^1.21.0",
    "bootstrap": "^5.3.8",
    "bootstrap-vue-next": "^0.45.10",
    "bootswatch": "^5.3.8",
    "d3": "^7.9.0",
    "file-saver": "^2.0.5",
    "keycloak-js": "^26.2.4",
    "markdown-it": "^15.0.3",
    "pinia": "^4.1.0",
    "sanitize-html": "^2.18.1",
    "swagger-ui": "^5.34.0",
    "swagger-ui-dist": "^5.34.0",
    "timeclicker_server": "workspace:^",
    "vue": "^3.5.44",
